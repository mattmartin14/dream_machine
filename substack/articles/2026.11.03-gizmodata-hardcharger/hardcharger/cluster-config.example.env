# Copy to cluster-config.local.env (gitignored). AWS_REGION configures the AWS
# stack separately. The supplied Hardcharger request targets us-east-2.
HC_API_ENDPOINT=https://app.gizmodata.com/api/database-clusters/?wait=false
HC_API_METHOD=POST
HC_API_HEADERS_JSON='{"Authorization":"Bearer ${GIZMODATA_API_KEY}","Content-Type":"application/json"}'
HC_API_PAYLOAD_TEMPLATE=hardcharger/cluster-request.json.template

# GizmoData assigns the cluster ID when the create request succeeds.
HC_CLUSTER_NAME=smart-falcon-204
HC_CLUSTER_LABEL="Smart Falcon 204"
HC_PROJECT_ENVIRONMENT_ID=<your-project-environment-id>
HC_ADMIN_USERNAME=
HC_COMPUTE_INSTANCE_SIZE=r8gd.xlarge
# GizmoData confirmed "hardcharger-latest" tracks the newest supported image.
HC_DATABASE_IMAGE=hardcharger-latest
HC_CLOUD_REGION_ID=9e30c6da-3174-5a8b-ab3f-a8ad72206e80
HC_DEFAULT_CATALOG_ID=7fc7891b-b6f4-480f-a878-054adbf18a35
# Hardcharger RBAC store (PostgreSQL access-control catalog). Required for users, roles,
# grants and row policies (sql/readonly_demo). Leave empty to create the cluster without them.
HC_ACCESS_CONTROL_CATALOG_ID=d0687822-ad61-4743-98c2-0806e6eb3b7d
HC_DNS_LABEL=smart-falcon-204
HARDCHARGER_CLOUD_REGION=us-east-2
HC_ALLOW_ANY_IP=false
# Populate with the exact documented portal/API representation before provisioning.
HC_IP_ACCESS_LIST_JSON='[]'

# Provide both values via the process environment/CI secret store, never commit.
# export GIZMODATA_API_KEY=...
# export HC_ADMIN_PASSWORD=...

# These response selectors are intentionally unset: the supplied curl request
# contains no response. Fill from GizmoData's actual POST response documentation.
HC_RESPONSE_ID_JQ=
HC_RESPONSE_URI_JQ=
HC_RESPONSE_USERNAME_JQ=
HC_RESPONSE_PASSWORD_JQ=
HC_SECRET_ID=

# The supplied create request uses wait=false. Its response schema is still
# needed for the jq selectors below.
HC_READY_ENDPOINT_TEMPLATE=
HC_READY_METHOD=
HC_READY_STATE_JQ=
HC_READY_SUCCESS_VALUE=
HC_READY_TIMEOUT_SECONDS=900
HC_READY_POLL_SECONDS=10

# Optional S3 secret mounted on the cluster. Skipped when HC_AWS_PERSONAL_KEY is unset.
# Credentials come from the environment: HC_AWS_PERSONAL_BUCKET / _KEY / _SECRET.
HC_ORGANIZATION_ID=<your-organization-id>
HC_S3_SECRET_TYPE_ID=71ba52ae-71a7-526a-a487-868c9b220941
HC_S3_SECRET_NAME=hardcharger-personal-s3
HC_AWS_PERSONAL_REGION=us-east-1

# Persisted DuckDB database created via /api/databases/ and mounted read-write.
# Created empty on each build; provision.sh refuses to reuse an existing one (set
# HC_REUSE_PERSIST_DB=true to override) and destroy.sh deletes it.
HC_PERSIST_DB_NAME=order_stats
